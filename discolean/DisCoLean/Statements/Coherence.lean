import DisCoLean.Coherence
import DisCoLean.Mathlib

/-!
# What is proved of the categories compiled from `discopy.abc`

`ABC.lean` is generated by `python -m discopy.lean` from the classes of
`discopy.abc`, and `test/lean.py` checks it is up to date. The theorems here
are about it: a compiled category is a category of Mathlib, and Diagram(S)
has the laws of `monoidal.Diagram`. `Audit.lean` covers this file.
-/

namespace Statements.Coherence
open _root_.Premonoidal DisCoLean

/-- A compiled category with its laws is a category of Mathlib whose
morphisms from `A` to `B` are those with this boundary.
Rules out: a compiled `cut` whose typing law does not let `comp` land in
the hom-set it should. -/
theorem toMathlib_hom {Ob : Type u} {Hom : Type v} (C : ABC.Category Ob Hom)
    (laws : C.Laws) (A B : C.Obj) :
    @Quiver.Hom _ (C.toMathlib laws).toQuiver A B
      = {f : Hom // C.dom f = A.ob ∧ C.cod f = B.ob} := rfl

/-- A strict premonoidal category has the laws of `monoidal.Diagram`, the
tensor of morphisms being `f ⋉ dom g` then `cod f ⋊ g`.
Rules out: a tensor of morphisms that is not the identity on identities. -/
theorem monoidal (C : StrictPremonoidal) :
    C.toABC.tensor = C.tensorHom ∧ ABC.monoidal C.toABC :=
  ⟨rfl, C.toABC_monoidal⟩

/-- Diagram(S) has the laws of `monoidal.Diagram`.
Rules out: a compiled theory that keeps the bifunctoriality the Python
declares broken, which `Statements.Premonoidal.not_monoidal` refutes. -/
theorem diagram (S : Signature) [DecidableEq S.Ob] :
    ABC.monoidal (Diagram.premonoidal S).toABC := Diagram.monoidal S

end Statements.Coherence

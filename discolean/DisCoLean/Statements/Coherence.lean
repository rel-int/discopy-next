import DisCoLean.Coherence
import DisCoLean.Mathlib

/-!
# What is proved of the categories compiled from `discopy.abc`

`ABC.lean` is generated by `python -m discopy.lean` from the classes of
`discopy.abc`, and `test/lean.py` checks it is up to date. The theorems here
are about it: a compiled category is a category of Mathlib, and Diagram(S)
is the free model of the laws of `monoidal.Diagram`. `Audit.lean` covers this file.
-/

namespace Statements.Coherence
open _root_.Premonoidal DisCoLean

/-- A compiled category with its laws is a category of Mathlib whose
morphisms from `A` to `B` are those with this boundary.
Rules out: a compiled `cut` whose typing law does not let `comp` land in
the hom-set it should. -/
theorem toMathlib_hom {Ob : Type u} {Hom : Type v} (C : ABC.Category Ob Hom)
    (laws : C.Laws) (A B : C.Obj) :
    @Quiver.Hom _ (C.toMathlib laws).toQuiver A B
      = {f : Hom // C.dom f = A.ob ∧ C.cod f = B.ob} := rfl

/-- A strict premonoidal category has the laws of `ABC.monoidal`, those of
`abc.MonoidalCategory` but the bifunctoriality `monoidal.Diagram` declares
broken, the tensor of morphisms being `f ⋉ dom g` then `cod f ⋊ g`.
Rules out: a tensor of morphisms that is not the identity on identities. -/
theorem monoidal (C : StrictPremonoidal) :
    C.toABC.tensor = C.tensorHom ∧ ABC.monoidal C.toABC :=
  ⟨rfl, C.toABC_monoidal⟩

/-- Diagram(S) has the laws of `ABC.monoidal`, not bifunctoriality: this is
one half of `free`, the coherence theorem.
Rules out: a compiled theory that keeps the bifunctoriality the Python
declares broken, which `Statements.Premonoidal.not_monoidal` refutes. -/
theorem diagram (S : Signature) [DecidableEq S.Ob] :
    ABC.monoidal (Diagram.premonoidal S).toABC := Diagram.monoidal S

/-- **Coherence of `discopy.monoidal`**: Diagram(S) is the free model of
the laws of `abc.MonoidalCategory` that `monoidal.Diagram` does not declare
broken. A compiled functor to any model, sending each generating object and
each box where given, exists and is unique.
Rules out: a compiled theory too weak to pin down the tensor of diagrams,
e.g. one without the whiskering laws, whose free model is bigger. -/
theorem free {S : Signature} [DecidableEq S.Ob] {Ob : Type u} {Hom : Type v}
    {M : ABC.MonoidalCategory Ob Hom} (laws : ABC.monoidal M)
    (ob : S.Ob → Ob) (ar : S.Box → Hom)
    (hdom : ∀ b, M.dom (ar b) = Lift.obs (ABC.MonoidalCategory.ofABC laws) ob (S.dom b))
    (hcod : ∀ b, M.cod (ar b) = Lift.obs (ABC.MonoidalCategory.ofABC laws) ob (S.cod b)) :
    ∃ F : ABC.MonoidalCategory.Functor (Diagram.premonoidal S).toABC M,
      (∀ x, F.ob [x] = ob x) ∧ (∀ b, F.map (Diagram.box b) = ar b) ∧
      ∀ G : ABC.MonoidalCategory.Functor (Diagram.premonoidal S).toABC M,
        (∀ x, G.ob [x] = ob x) → (∀ b, G.map (Diagram.box b) = ar b) → G = F :=
  Diagram.free laws ob ar hdom hcod

end Statements.Coherence

namespace DisCoLean.ABC

universe u v

variable {Ob : Type u} {Hom : Type v}

/-- `discopy.abc.Category`: A category is a class with two class variables `ob, ar`, two attributes `dom, cod` and two methods `id, then`. -/
structure Category (Ob : Type u) (Hom : Type v) where
  dom : Hom → Ob
  cod : Hom → Ob
  id : Ob → Hom
  comp : Hom → Hom → Hom
  /-- `ax`: The axiom rule: the identity on an object. -/
  ax : ∀ (X : Ob), dom (id X) = X ∧ cod (id X) = X
  /-- `cut`: The cut rule: the composition of two morphisms. -/
  cut : ∀ (A B C : Ob) (f g : Hom), dom f = A → cod f = B → dom g = B → cod g = C → dom (comp f g) = A ∧ cod (comp f g) = C

/-- Left and right unitality of composition. -/
def Category.unitality (cat : Category Ob Hom) : Prop :=
  ∀ (A B : Ob) (f : Hom), cat.dom f = A → cat.cod f = B → cat.comp (cat.id (cat.dom f)) f = f ∧ f = cat.comp f (cat.id (cat.cod f))

/-- Associativity of composition. -/
def Category.associativity (cat : Category Ob Hom) : Prop :=
  ∀ (A B C D : Ob) (f g h : Hom), cat.dom f = A → cat.cod f = B → cat.dom g = B → cat.cod g = C → cat.dom h = C → cat.cod h = D → cat.comp (cat.comp f g) h = cat.comp f (cat.comp g h)

/-- The laws of `Category`. -/
structure Category.Laws (cat : Category Ob Hom) : Prop where
  unitality : cat.unitality
  associativity : cat.associativity

/-- `discopy.abc.DaggerCategory`: A [dagger category](https://ncatlab.org/nlab/show/dagger+category) is a `Category` with a method `dagger` for the identity-on-objects contravariant involution, i.e. such that `(f >> g).dagger() == g.dagger() >> f.dagger()` and `f.dagger().dagger() == f`. -/
structure DaggerCategory (Ob : Type u) (Hom : Type v) extends Category Ob Hom where
  dagger : Hom → Hom

/-- The dagger is involutive. -/
def DaggerCategory.dagger_involution (cat : DaggerCategory Ob Hom) : Prop :=
  ∀ (A B : Ob) (f : Hom), cat.dom f = A → cat.cod f = B → cat.dagger (cat.dagger f) = f

/-- The dagger reverses composition. -/
def DaggerCategory.dagger_contravariance (cat : DaggerCategory Ob Hom) : Prop :=
  ∀ (A B C : Ob) (f g : Hom), cat.dom f = A → cat.cod f = B → cat.dom g = B → cat.cod g = C → cat.dagger (cat.comp f g) = cat.comp (cat.dagger g) (cat.dagger f)

/-- The laws of `DaggerCategory`. -/
structure DaggerCategory.Laws (cat : DaggerCategory Ob Hom) : Prop extends toCategory : Category.Laws cat.toCategory where
  dagger_involution : cat.dagger_involution
  dagger_contravariance : cat.dagger_contravariance

/-- `discopy.abc.ColouredMonoid`: A coloured monoid is a category whose sequential composition `then` is given by a monoidal `tensor`, with the objects `C0` (its colours) as the boundaries of its morphisms. -/
structure ColouredMonoid (Ob : Type u) (Hom : Type v) extends Category Ob Hom where

/-- The laws of `ColouredMonoid`. -/
structure ColouredMonoid.Laws (cat : ColouredMonoid Ob Hom) : Prop extends toCategory : Category.Laws cat.toCategory

/-- `discopy.abc.Monoid`: A monoid is a coloured monoid with a single, trivial colour. -/
structure Monoid (Ob : Type u) (Hom : Type v) extends ColouredMonoid Ob Hom where

/-- The laws of `Monoid`. -/
structure Monoid.Laws (cat : Monoid Ob Hom) : Prop extends toColouredMonoid : ColouredMonoid.Laws cat.toColouredMonoid

/-- `discopy.abc.Groupoid`: A groupoid is a category in which every arrow is invertible, its inverse being its dagger: a dagger category whose dagger is the inverse. -/
structure Groupoid (Ob : Type u) (Hom : Type v) extends DaggerCategory Ob Hom where

/-- An arrow followed or preceded by its dagger is an identity. -/
def Groupoid.invertibility (cat : Groupoid Ob Hom) : Prop :=
  ∀ (A B : Ob) (f : Hom), cat.dom f = A → cat.cod f = B → (cat.comp f (cat.dagger f), cat.comp (cat.dagger f) f) = (cat.id (cat.dom f), cat.id (cat.cod f))

/-- The laws of `Groupoid`. -/
structure Groupoid.Laws (cat : Groupoid Ob Hom) : Prop extends toDaggerCategory : DaggerCategory.Laws cat.toDaggerCategory where
  invertibility : cat.invertibility

/-- `discopy.abc.Group`: A group is a monoid whose elements are invertible, i.e. a groupoid with a single object `None`, which every element goes from and to. -/
structure Group (Ob : Type u) (Hom : Type v) extends Groupoid Ob Hom, Monoid Ob Hom where

/-- The laws of `Group`. -/
structure Group.Laws (cat : Group Ob Hom) : Prop extends toGroupoid : Groupoid.Laws cat.toGroupoid, toMonoid : Monoid.Laws cat.toMonoid

/-- `discopy.abc.MonoidalCategory`: A monoidal category is a `Category` with a method `tensor` for both its objects and its morphisms. -/
structure MonoidalCategory (Ob : Type u) (Hom : Type v) extends Category Ob Hom where
  tensor : Hom → Hom → Hom
  tensorOb : Ob → Ob → Ob
  /-- `mix`: The mix rule: the tensor of two morphisms. -/
  mix : ∀ (A B C D : Ob) (f g : Hom), dom f = A → cod f = B → dom g = C → cod g = D → dom (tensor f g) = tensorOb A C ∧ cod (tensor f g) = tensorOb B D

/-- Bifunctoriality of the tensor, i.e. the interchange law. -/
def MonoidalCategory.bifunctoriality (cat : MonoidalCategory Ob Hom) : Prop :=
  ∀ (A B C D U V : Ob) (f g h k : Hom), cat.dom f = A → cat.cod f = B → cat.dom g = C → cat.cod g = D → cat.dom h = B → cat.cod h = U → cat.dom k = D → cat.cod k = V → cat.comp (cat.tensor f g) (cat.tensor h k) = cat.tensor (cat.comp f h) (cat.comp g k)

/-- Preservation of identities by tensor. -/
def MonoidalCategory.tensor_unitality (cat : MonoidalCategory Ob Hom) : Prop :=
  ∀ (X Y : Ob), cat.tensor (cat.id X) (cat.id Y) = cat.id (cat.tensorOb X Y)

/-- The laws of `MonoidalCategory`. -/
structure MonoidalCategory.Laws (cat : MonoidalCategory Ob Hom) : Prop extends toCategory : Category.Laws cat.toCategory where
  bifunctoriality : cat.bifunctoriality
  tensor_unitality : cat.tensor_unitality

/-- `discopy.abc.DaggerMonoidalCategory`: A dagger monoidal category is a `DaggerCategory` and a `MonoidalCategory` whose dagger distributes over the tensor, see `Selinger10`. -/
structure DaggerMonoidalCategory (Ob : Type u) (Hom : Type v) extends DaggerCategory Ob Hom, MonoidalCategory Ob Hom where

/-- The dagger distributes over the tensor. -/
def DaggerMonoidalCategory.dagger_monoidality (cat : DaggerMonoidalCategory Ob Hom) : Prop :=
  ∀ (A B C D : Ob) (f g : Hom), cat.dom f = A → cat.cod f = B → cat.dom g = C → cat.cod g = D → cat.dagger (cat.tensor f g) = cat.tensor (cat.dagger f) (cat.dagger g)

/-- The laws of `DaggerMonoidalCategory`. -/
structure DaggerMonoidalCategory.Laws (cat : DaggerMonoidalCategory Ob Hom) : Prop extends toDaggerCategory : DaggerCategory.Laws cat.toDaggerCategory, toMonoidalCategory : MonoidalCategory.Laws cat.toMonoidalCategory where
  dagger_monoidality : cat.dagger_monoidality

/-- `discopy.abc.SpacialCategory`: A spacial category is a `MonoidalCategory` where scalars slide: a scalar `s : I -> I` on the left of any morphism is the same scalar on its right, see `Selinger10`. -/
structure SpacialCategory (Ob : Type u) (Hom : Type v) extends MonoidalCategory Ob Hom where
  unitOb : Ob

/-- A scalar on the left of a morphism is a scalar on its right. -/
def SpacialCategory.scalar_sliding (cat : SpacialCategory Ob Hom) : Prop :=
  ∀ (A B : Ob) (scalar f : Hom), cat.dom scalar = cat.unitOb → cat.cod scalar = cat.unitOb → cat.dom f = A → cat.cod f = B → cat.tensor scalar f = cat.tensor f scalar

/-- The laws of `SpacialCategory`. -/
structure SpacialCategory.Laws (cat : SpacialCategory Ob Hom) : Prop extends toMonoidalCategory : MonoidalCategory.Laws cat.toMonoidalCategory where
  scalar_sliding : cat.scalar_sliding

/-- `discopy.abc.PRO`: A PRO is a `MonoidalCategory` whose objects are the natural numbers `Nat`, i.e. the free monoidal category on one generator. -/
structure PRO (Ob : Type u) (Hom : Type v) extends MonoidalCategory Ob Hom where

/-- The laws of `PRO`. -/
structure PRO.Laws (cat : PRO Ob Hom) : Prop extends toMonoidalCategory : MonoidalCategory.Laws cat.toMonoidalCategory

/-- `discopy.abc.ResiduatedMonoid`: A monoid is residuated when it comes with methods `over` and `under` with syntactic sugar `<<` and `>>`. -/
structure ResiduatedMonoid (Ob : Type u) (Hom : Type v) extends ColouredMonoid Ob Hom where

/-- The laws of `ResiduatedMonoid`. -/
structure ResiduatedMonoid.Laws (cat : ResiduatedMonoid Ob Hom) : Prop extends toColouredMonoid : ColouredMonoid.Laws cat.toColouredMonoid

/-- `discopy.abc.Pregroup`: A pregroup is a residuated monoid where the left and right exponentials are given by tensoring with the chosen left and right duals for each object. -/
structure Pregroup (Ob : Type u) (Hom : Type v) extends ResiduatedMonoid Ob Hom where

/-- The laws of `Pregroup`. -/
structure Pregroup.Laws (cat : Pregroup Ob Hom) : Prop extends toResiduatedMonoid : ResiduatedMonoid.Laws cat.toResiduatedMonoid

/-- `discopy.abc.BraidedCategory`: A braided category is a `MonoidalCategory` with a method `braid` for the natural isomorphism `x @ y -> y @ x`. -/
structure BraidedCategory (Ob : Type u) (Hom : Type v) extends SpacialCategory Ob Hom where
  braid : Ob → Ob → Hom
  braid_inverse : Ob → Ob → Hom
  /-- `braiding`: The braid of two atoms. -/
  braiding : ∀ (X Y : Ob), dom (braid X Y) = tensorOb X Y ∧ cod (braid X Y) = tensorOb Y X
  /-- `inverse_braiding`: The inverse of the braid of two atoms. -/
  inverse_braiding : ∀ (X Y : Ob), dom (braid_inverse X Y) = tensorOb Y X ∧ cod (braid_inverse X Y) = tensorOb X Y

/-- The braid followed by its inverse is the identity. -/
def BraidedCategory.braid_then_inverse (cat : BraidedCategory Ob Hom) : Prop :=
  ∀ (X Y : Ob), cat.comp (cat.braid X Y) (cat.braid_inverse X Y) = cat.id (cat.tensorOb X Y)

/-- The inverse of the braid followed by it is the identity. -/
def BraidedCategory.inverse_then_braid (cat : BraidedCategory Ob Hom) : Prop :=
  ∀ (X Y : Ob), cat.comp (cat.braid_inverse X Y) (cat.braid X Y) = cat.id (cat.tensorOb Y X)

/-- The left hexagon equation. -/
def BraidedCategory.hexagon_left (cat : BraidedCategory Ob Hom) : Prop :=
  ∀ (X Y Z : Ob), cat.braid X (cat.tensorOb Y Z) = cat.comp (cat.tensor (cat.braid X Y) (cat.id Z)) (cat.tensor (cat.id Y) (cat.braid X Z))

/-- The right hexagon equation. -/
def BraidedCategory.hexagon_right (cat : BraidedCategory Ob Hom) : Prop :=
  ∀ (X Y Z : Ob), cat.braid (cat.tensorOb X Y) Z = cat.comp (cat.tensor (cat.id X) (cat.braid Y Z)) (cat.tensor (cat.braid X Z) (cat.id Y))

/-- Naturality of the braid. -/
def BraidedCategory.braid_naturality (cat : BraidedCategory Ob Hom) : Prop :=
  ∀ (A B C D : Ob) (f g : Hom), cat.dom f = A → cat.cod f = B → cat.dom g = C → cat.cod g = D → cat.comp (cat.tensor f g) (cat.braid (cat.cod f) (cat.cod g)) = cat.comp (cat.braid (cat.dom f) (cat.dom g)) (cat.tensor g f)

/-- The laws of `BraidedCategory`. -/
structure BraidedCategory.Laws (cat : BraidedCategory Ob Hom) : Prop extends toSpacialCategory : SpacialCategory.Laws cat.toSpacialCategory where
  braid_then_inverse : cat.braid_then_inverse
  inverse_then_braid : cat.inverse_then_braid
  hexagon_left : cat.hexagon_left
  hexagon_right : cat.hexagon_right
  braid_naturality : cat.braid_naturality

/-- `discopy.abc.PROB`: A PROB is a `BraidedCategory` whose objects are the natural numbers `Nat`, i.e. the free braided category on one generator. -/
structure PROB (Ob : Type u) (Hom : Type v) extends PRO Ob Hom, BraidedCategory Ob Hom where

/-- The laws of `PROB`. -/
structure PROB.Laws (cat : PROB Ob Hom) : Prop extends toPRO : PRO.Laws cat.toPRO, toBraidedCategory : BraidedCategory.Laws cat.toBraidedCategory

/-- The laws of `MonoidalCategory` that `monoidal.Diagram` does not declare broken. -/
def monoidal (cat : MonoidalCategory Ob Hom) : Prop :=
  cat.unitality ∧ cat.associativity ∧ cat.tensor_unitality

end DisCoLean.ABC

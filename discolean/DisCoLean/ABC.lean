/-- `discopy.abc.PRO`: A PRO is a `MonoidalCategory` whose objects are the natural numbers `Nat`, i.e. the free monoidal category on one generator. -/
structure PRO (Hom : Type v) extends MonoidalCategory Nat Hom where

/-- The laws of `PRO`. -/

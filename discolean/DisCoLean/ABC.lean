/-- `discopy.abc.MonoidalCategory`: A monoidal category is a `Category` with a method `tensor` for both its objects and its morphisms. -/
structure MonoidalCategory (Ob : Type u) (Hom : Type v) extends Category Ob Hom where
  tensor : Hom → Hom → Hom
  tensorOb : Ob → Ob → Ob
  unitOb : Ob
  /-- `mix`: The mix rule: the tensor of two morphisms. -/
  mix : ∀ (A B C D : Ob) (f g : Hom), dom f = A → cod f = B → dom g = C → cod g = D → dom (tensor f g) = tensorOb A C ∧ cod (tensor f g) = tensorOb B D

/-- Bifunctoriality of the tensor, i.e. the interchange law. -/
def MonoidalCategory.bifunctoriality (cat : MonoidalCategory Ob Hom) : Prop :=
  ∀ (A B C D U V : Ob) (f g h k : Hom), cat.dom f = A → cat.cod f = B → cat.dom g = C → cat.cod g = D → cat.dom h = B → cat.cod h = U → cat.dom k = D → cat.cod k = V → cat.comp (cat.tensor f g) (cat.tensor h k) = cat.tensor (cat.comp f h) (cat.comp g k)

/-- Preservation of identities by tensor. -/
def MonoidalCategory.tensor_unitality (cat : MonoidalCategory Ob Hom) : Prop :=
  ∀ (X Y : Ob), cat.tensor (cat.id X) (cat.id Y) = cat.id (cat.tensorOb X Y)

/-- Associativity of the tensor of morphisms. -/
def MonoidalCategory.tensor_associativity (cat : MonoidalCategory Ob Hom) : Prop :=
  ∀ (A B C D U V : Ob) (f g h : Hom), cat.dom f = A → cat.cod f = B → cat.dom g = C → cat.cod g = D → cat.dom h = U → cat.cod h = V → cat.tensor (cat.tensor f g) h = cat.tensor f (cat.tensor g h)

/-- The unit object is a unit for the tensor of morphisms. -/
def MonoidalCategory.tensor_unit (cat : MonoidalCategory Ob Hom) : Prop :=
  ∀ (A B : Ob) (f : Hom), cat.dom f = A → cat.cod f = B → cat.tensor (cat.id cat.unitOb) f = f ∧ f = cat.tensor f (cat.id cat.unitOb)

/-- Whiskering on the left is a functor. -/
def MonoidalCategory.left_whiskering (cat : MonoidalCategory Ob Hom) : Prop :=
  ∀ (X A B C : Ob) (f g : Hom), cat.dom f = A → cat.cod f = B → cat.dom g = B → cat.cod g = C → cat.tensor (cat.id X) (cat.comp f g) = cat.comp (cat.tensor (cat.id X) f) (cat.tensor (cat.id X) g)

/-- Whiskering on the right is a functor. -/
def MonoidalCategory.right_whiskering (cat : MonoidalCategory Ob Hom) : Prop :=
  ∀ (X A B C : Ob) (f g : Hom), cat.dom f = A → cat.cod f = B → cat.dom g = B → cat.cod g = C → cat.tensor (cat.comp f g) (cat.id X) = cat.comp (cat.tensor f (cat.id X)) (cat.tensor g (cat.id X))

/-- The tensor of two morphisms is the first whiskered by the domain of the second, then the second whiskered by the codomain of the first: with the laws above, those of a strict premonoidal category, which unlike `bifunctoriality` hold of `discopy.monoidal`. -/
def MonoidalCategory.tensor_whiskering (cat : MonoidalCategory Ob Hom) : Prop :=
  ∀ (A B C D : Ob) (f g : Hom), cat.dom f = A → cat.cod f = B → cat.dom g = C → cat.cod g = D → cat.tensor f g = cat.comp (cat.tensor f (cat.id (cat.dom g))) (cat.tensor (cat.id (cat.cod f)) g)

/-- The laws of `MonoidalCategory`. -/
structure MonoidalCategory.Laws (cat : MonoidalCategory Ob Hom) : Prop extends toCategory : Category.Laws cat.toCategory where
  bifunctoriality : cat.bifunctoriality
  tensor_unitality : cat.tensor_unitality
  tensor_associativity : cat.tensor_associativity
  tensor_unit : cat.tensor_unit
  left_whiskering : cat.left_whiskering
  right_whiskering : cat.right_whiskering
  tensor_whiskering : cat.tensor_whiskering

/-- A functor of `MonoidalCategory`: it preserves each of its operations. -/
structure MonoidalCategory.Functor (cat : MonoidalCategory Ob Hom) (cat' : MonoidalCategory Ob' Hom') extends toCategory : Category.Functor cat.toCategory cat'.toCategory where
  map_tensor : ∀ (A B C D : Ob) (f g : Hom), cat.dom f = A → cat.cod f = B → cat.dom g = C → cat.cod g = D → map (cat.tensor f g) = cat'.tensor (map f) (map g)
  ob_tensorOb : ∀ (X Y : Ob), ob (cat.tensorOb X Y) = cat'.tensorOb (ob X) (ob Y)
  ob_unitOb : ob cat.unitOb = cat'.unitOb

/-- `discopy.abc.DaggerMonoidalCategory`: A dagger monoidal category is a `DaggerCategory` and a `MonoidalCategory` whose dagger distributes over the tensor, see `Selinger10`. -/
structure DaggerMonoidalCategory (Ob : Type u) (Hom : Type v) extends DaggerCategory Ob Hom, MonoidalCategory Ob Hom where

/-- The dagger distributes over the tensor. -/
def DaggerMonoidalCategory.dagger_monoidality (cat : DaggerMonoidalCategory Ob Hom) : Prop :=
  ∀ (A B C D : Ob) (f g : Hom), cat.dom f = A → cat.cod f = B → cat.dom g = C → cat.cod g = D → cat.dagger (cat.tensor f g) = cat.tensor (cat.dagger f) (cat.dagger g)

/-- The laws of `DaggerMonoidalCategory`. -/
structure DaggerMonoidalCategory.Laws (cat : DaggerMonoidalCategory Ob Hom) : Prop extends toDaggerCategory : DaggerCategory.Laws cat.toDaggerCategory, toMonoidalCategory : MonoidalCategory.Laws cat.toMonoidalCategory where

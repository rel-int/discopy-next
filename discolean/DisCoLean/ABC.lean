def Category.unitality (cat : Category Ob Hom) : Prop :=
  ∀ (A B : Ob) (f : Hom), cat.dom f = A → cat.cod f = B → cat.comp (cat.id (cat.dom f)) f = f ∧ f = cat.comp f (cat.id (cat.cod f))

/-- Associativity of composition. -/
def Category.associativity (cat : Category Ob Hom) : Prop :=
  ∀ (A B C D : Ob) (f g h : Hom), cat.dom f = A → cat.cod f = B → cat.dom g = B → cat.cod g = C → cat.dom h = C → cat.cod h = D → cat.comp (cat.comp f g) h = cat.comp f (cat.comp g h)


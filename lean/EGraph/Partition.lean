/-!
# The finest partition relating some pairs

The model of `discopy.egraph.partition`: the classes of `n` spiders are a list
of length `n` giving the least spider of the class of each. Python's is a
union-find with path halving; this one rewrites the whole list for each pair,
which is what the union-find computes, as `partition_least` says of this one
and the differential test of the two.
-/

namespace EGraph

/-- Relate two spiders: the greater of their classes becomes the lesser. -/
def relate (classes : List Nat) (i j : Nat) : List Nat :=
  let a := classes.getD i i
  let b := classes.getD j j
  classes.map fun c => if c = max a b then min a b else c

/-- The finest partition of `n` spiders relating each pair, as the least
spider of the class of each spider. -/
def partition (n : Nat) (pairs : List (Nat × Nat)) : List Nat :=
  pairs.foldl (fun classes pair => relate classes pair.1 pair.2) (List.range n)

/-- The equivalence generated by some pairs. -/
inductive Related (pairs : List (Nat × Nat)) : Nat → Nat → Prop
  | pair {i j} : (i, j) ∈ pairs → Related pairs i j
  | refl (i) : Related pairs i i
  | symm {i j} : Related pairs i j → Related pairs j i
  | trans {i j k} : Related pairs i j → Related pairs j k → Related pairs i k

namespace Related

theorem equivalence (pairs : List (Nat × Nat)) : Equivalence (Related pairs) :=
  ⟨refl, symm, trans⟩

/-- Two spiders are related when every equivalence with the pairs says so. -/
theorem iff_forall {pairs : List (Nat × Nat)} {i j : Nat} :
    Related pairs i j ↔ ∀ r : Nat → Nat → Prop,
      Equivalence r → (∀ p ∈ pairs, r p.1 p.2) → r i j := by
  constructor
  · intro related r eqv holds
    induction related with
    | pair mem => exact holds _ mem
    | refl i => exact eqv.refl i
    | symm _ ih => exact eqv.symm ih
    | trans _ _ ih ih' => exact eqv.trans ih ih'
  · intro h
    exact h _ (equivalence pairs) fun _ mem => pair mem

/-- Pairs related by other pairs generate no more than them. -/
theorem sub {pairs more : List (Nat × Nat)}
    (sub : ∀ p ∈ pairs, Related more p.1 p.2)
    {i j : Nat} (related : Related pairs i j) : Related more i j :=
  iff_forall.1 related _ (equivalence more) sub

theorem mono {pairs more : List (Nat × Nat)} (sub : ∀ p ∈ pairs, p ∈ more)
    {i j : Nat} (related : Related pairs i j) : Related more i j :=
  related.sub fun p mem => pair (sub p mem)

/-- Pairs below `n` leave every spider from `n` on alone. -/
theorem eq_of_ge {n : Nat} {pairs : List (Nat × Nat)}
    (bound : ∀ p ∈ pairs, p.1 < n ∧ p.2 < n) {i j : Nat}
    (related : Related pairs i j) (ge : n ≤ i) : i = j := by
  have := iff_forall.1 related (fun i j => i = j ∨ (i < n ∧ j < n))
    ⟨fun _ => .inl rfl, fun h => by omega, fun h h' => by omega⟩
    fun p mem => .inr (bound p mem)
  omega

end Related

/-! ## The proof, on functions

A function `c` on spiders is the canonical form of the pairs when it sends
each spider to a related one, related spiders to the same one, and never up.
-/

/-- `relate` on a function. -/
def join (c : Nat → Nat) (i j : Nat) : Nat → Nat :=
  fun k => if c k = max (c i) (c j) then min (c i) (c j) else c k

structure Canonical (pairs : List (Nat × Nat)) (c : Nat → Nat) : Prop where
  related : ∀ k, Related pairs k (c k)
  equal : ∀ k l, Related pairs k l → c k = c l
  below : ∀ k, c k ≤ k

theorem Canonical.id : Canonical [] id where
  related := Related.refl
  equal k l related := by
    induction related with
    | pair mem => cases mem
    | refl => rfl
    | symm _ ih => exact ih.symm
    | trans _ _ ih ih' => exact ih.trans ih'
  below _ := Nat.le_refl _

theorem Canonical.join {pairs : List (Nat × Nat)} {c : Nat → Nat}
    (h : Canonical pairs c) (i j : Nat) :
    Canonical (pairs ++ [(i, j)]) (join c i j) := by
  have old {k l} (r : Related pairs k l) : Related (pairs ++ [(i, j)]) k l :=
    r.mono fun _ mem => List.mem_append_left _ mem
  have new : Related (pairs ++ [(i, j)]) (c i) (c j) :=
    ((old (h.related i)).symm.trans (.pair (by simp))).trans (old (h.related j))
  refine ⟨fun k => ?_, fun k l related => ?_, fun k => ?_⟩
  · refine (old (h.related k)).trans ?_
    unfold EGraph.join
    split
    · rename_i eq
      rw [eq]
      rcases Nat.le_total (c i) (c j) with le | le
      · rw [Nat.max_eq_right le, Nat.min_eq_left le]; exact new.symm
      · rw [Nat.max_eq_left le, Nat.min_eq_right le]; exact new
    · exact .refl _
  · induction related with
    | pair mem =>
      rcases List.mem_append.1 mem with mem | mem
      · simp only [EGraph.join, h.equal _ _ (.pair mem)]
      · cases List.mem_singleton.1 mem
        simp only [EGraph.join]
        split <;> split <;> omega
    | refl => rfl
    | symm _ ih => exact ih.symm
    | trans _ _ ih ih' => exact ih.trans ih'
  · have := h.below k
    simp only [EGraph.join]
    split <;> omega

theorem Canonical.foldl (pairs : List (Nat × Nat)) :
    ∀ (done : List (Nat × Nat)) (c : Nat → Nat), Canonical done c →
      Canonical (done ++ pairs)
        (pairs.foldl (fun c pair => EGraph.join c pair.1 pair.2) c) := by
  induction pairs with
  | nil => intro done c h; simpa using h
  | cons pair pairs ih =>
    intro done c h
    have := ih _ _ (h.join pair.1 pair.2)
    simpa using this

/-! ## From functions to lists -/

/-- A list of classes holds the values of a function on the first `n`. -/
def Holds (n : Nat) (classes : List Nat) (c : Nat → Nat) : Prop :=
  classes.length = n ∧ ∀ k, k < n → classes[k]? = some (c k)

theorem Holds.relate {n : Nat} {classes : List Nat} {c : Nat → Nat}
    (h : Holds n classes c) {i j : Nat} (hi : i < n) (hj : j < n) :
    Holds n (relate classes i j) (join c i j) := by
  refine ⟨by simp [EGraph.relate, h.1], fun k hk => ?_⟩
  simp [EGraph.relate, EGraph.join, List.getD_eq_getElem?_getD,
    h.2 k hk, h.2 i hi, h.2 j hj]

theorem Holds.foldl {n : Nat} (pairs : List (Nat × Nat))
    (bound : ∀ p ∈ pairs, p.1 < n ∧ p.2 < n) :
    ∀ (classes : List Nat) (c : Nat → Nat), Holds n classes c →
      Holds n
        (pairs.foldl (fun classes pair => EGraph.relate classes pair.1 pair.2) classes)
        (pairs.foldl (fun c pair => EGraph.join c pair.1 pair.2) c) := by
  induction pairs with
  | nil => intro classes c h; exact h
  | cons pair pairs ih =>
    intro classes c h
    have ⟨hi, hj⟩ := bound pair (by simp)
    exact ih (fun p mem => bound p (by simp [mem])) _ _ (h.relate hi hj)

/-- `partition` holds the values of a canonical function of the pairs. -/
theorem partition_spec (n : Nat) (pairs : List (Nat × Nat))
    (bound : ∀ p ∈ pairs, p.1 < n ∧ p.2 < n) :
    ∃ c, Canonical pairs c ∧ Holds n (partition n pairs) c := by
  have canonical := Canonical.foldl pairs [] id Canonical.id
  rw [List.nil_append] at canonical
  exact ⟨_, canonical, Holds.foldl pairs bound (List.range n) id
    ⟨by simp, fun k hk => by simp [hk]⟩⟩

/-- The classes of `partition` are the canonical form of the equivalence
generated by the pairs: each spider is sent to the least spider related. -/
theorem partition_least (n : Nat) (pairs : List (Nat × Nat))
    (bound : ∀ p ∈ pairs, p.1 < n ∧ p.2 < n) :
    (partition n pairs).length = n ∧ ∀ i, i < n →
      ∃ c, (partition n pairs)[i]? = some c ∧ Related pairs i c
        ∧ ∀ j, Related pairs i j → c ≤ j := by
  have ⟨c, canonical, holds⟩ := partition_spec n pairs bound
  refine ⟨holds.1, fun i hi => ⟨_, holds.2 i hi, canonical.related i, fun j r => ?_⟩⟩
  exact canonical.equal i j r ▸ canonical.below j

end EGraph

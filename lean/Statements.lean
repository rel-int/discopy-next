import EGraph

/-!
# What is proved about the model of `discopy.egraph`

Every definition a theorem mentions is restated here by `rfl`, and every
theorem is restated with the proof it refers to and one broken implementation
it rules out. `Audit.lean` checks that none of them rests on `sorry`,
`native_decide` or an axiom beyond `propext`, `Quot.sound`, `Classical.choice`.
The model is linked to the Python by `test_oracle.py`, not by a proof.
-/

namespace Statements
open EGraph

/-! ## Definitions -/

/-- Classes are a list, the least spider of the class of each spider.
Relating two spiders sends the greater of their classes to the lesser. -/
theorem relate_def (classes : List Nat) (i j : Nat) :
    relate classes i j = classes.map fun c =>
      if c = max (classes.getD i i) (classes.getD j j)
      then min (classes.getD i i) (classes.getD j j) else c := rfl

/-- `partition` relates each pair in turn, from the identity. -/
theorem partition_def (n : Nat) (pairs : List (Nat × Nat)) :
    partition n pairs = pairs.foldl
      (fun classes pair => relate classes pair.1 pair.2) (List.range n) := rfl

/-- `Related pairs` is the equivalence generated by the pairs: what every
equivalence containing them relates. -/
theorem related_def (pairs : List (Nat × Nat)) (i j : Nat) :
    Related pairs i j ↔ ∀ r : Nat → Nat → Prop,
      Equivalence r → (∀ p ∈ pairs, r p.1 p.2) → r i j := Related.iff_forall

/-! ## Theorems -/

/-- The classes of `partition` are the canonical form of the equivalence
generated by the pairs: each spider goes to the least spider related to it.
Rules out: a union sending the lesser class to the greater, or relating a
pair without moving the rest of its class. -/
theorem partition_least (n : Nat) (pairs : List (Nat × Nat))
    (bound : ∀ p ∈ pairs, p.1 < n ∧ p.2 < n) :
    (partition n pairs).length = n ∧ ∀ i, i < n →
      ∃ c, (partition n pairs)[i]? = some c ∧ Related pairs i c
        ∧ ∀ j, Related pairs i j → c ≤ j :=
  EGraph.partition_least n pairs bound

end Statements

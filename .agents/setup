#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
SECONDS=0

echo 'Checking system dependencies'
packages=()
for package in graphviz pandoc; do
    if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != 'install ok installed' ]]; then
        packages+=("$package")
    fi
done
if ((${#packages[@]})); then
    sudo apt-get update
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${packages[@]}"
fi
echo "System dependencies ready (${SECONDS}s)"

echo 'Installing Python 3.14 and locked development dependencies'
uv python install 3.14
uv sync --locked --python 3.14 --group all
echo "Orb setup finished (${SECONDS}s)"
